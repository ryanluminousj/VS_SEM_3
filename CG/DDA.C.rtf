\
void DDAline(int x1, int y1, int x2, int y2)\
\{\
    int dx, dy, steps, i;\
    float x_inc, y_inc, x, y;\
\
    dx = x2 - x1;\
    dy = y2 - y1;\
\
    if (abs(dx) > abs(dy))\
        steps = abs(dx);\
    else\
        steps = abs(dy);\
\
    x_inc = (float)dx / steps;\
    y_inc = (float)dy / steps;\
\
    x = x1;\
    y = y1;\
\
    putpixel((int)(x + 0.5), (int)(y + 0.5), WHITE);\
\
    for (i = 0; i < steps; i++)\
    \{\
        x += x_inc;\
        y += y_inc;\
        putpixel((int)(x + 0.5), (int)(y + 0.5), WHITE);\
    \}\
\}\
\
int main()\
\{\
    int gd = DETECT, gm;\
    int x1, y1, x2, y2;\
\
    printf("Enter starting coordinates (x1 y1): ");\
    scanf("%d %d", &x1, &y1);\
\
    printf("Enter ending coordinates (x2 y2): ");\
    scanf("%d %d", &x2, &y2);\
\
    initgraph(&gd, &gm, "C:\\\\TURBOC3\\\\BGI");\
\
    DDAline(x1, y1, x2, y2);\
\
    getch();\
    closegraph();\
    return 0;\
\}}